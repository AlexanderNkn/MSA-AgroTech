Rel(notification_hub, notification_system, "Доставка уведомлений", "API")
Rel(integration_hub, erp_system, "Передача данных о поголовье и кормах", "REST")
Rel(integration_hub, bi_system, "Экспорт метрик и KPI", "REST")
Rel(integration_hub, event_backbone, "Подписка на события", "Kafka protocol")
Rel(video_analytics, ai_platform, "Модели и сервисы инференса", "REST")

Rel(livestock_service, oltp_db, "Чтение и запись", "SQL")
Rel(feeding_service, oltp_db, "Чтение и запись", "SQL")
Rel(equipment_service, oltp_db, "Чтение и запись", "SQL")
Rel(access_service, cache, "Кэш сессий", "Redis")
Rel(video_analytics, data_lake, "Сохранение видеофрагментов", "S3 API")
Rel(event_backbone, warehouse, "Поток в аналитику", "ETL/ELT")
