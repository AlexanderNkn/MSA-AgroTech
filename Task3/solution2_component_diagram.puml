System_Ext(notification_system, "Система уведомлений", "SMS, push, e-mail и мессенджеры")
System_Ext(ai_platform, "Облачная платформа моделей", "Облачный инференс и ML-сервисы")

System_Boundary(edge_boundary, "Ферма (тонкий периферийный шлюз)") {
    Component(device_bridge, "Device Bridge", "Go", "Сбор телеметрии и проксирование в облако")
    Component(edge_buffer, "Edge Ring Buffer", "Redis", "Буфер на случай обрыва связи")
    Component(local_alarm, "Local Emergency Notifier", "Python", "Локальный аварийный сигнал при отсутствии связи")
}

System_Boundary(cloud_boundary, "Облачная платформа") {
    Component(api_gateway, "API Gateway", "Kong/Managed API Gateway", "Вход, маршрутизация и ограничение скорости")
    Component(access_service, "Access Service", "Go", "Роли, проверка политик и сессии")
    Component(stream_ingest, "Stream Ingest", "Go", "Прием видео и телеметрии от ферм")
    Component(video_analytics, "Cloud Video Analytics", "Python + GPU", "Централизованный видеоинференс")
    Component(rule_engine, "Incident Rule Engine", "Go", "Правила инцидентов, дедупликация и эскалация")
    Component(livestock_service, "Livestock Service", "Go", "Учет животных и состояние стад")
    Component(feeding_service, "Feeding Service", "Go", "Управление кормлением и поением")
    Component(equipment_service, "Equipment Service", "Go", "Мониторинг инженерных систем")
    Component(notification_hub, "Notification Hub", "Go", "Оркестрация уведомлений")
    Component(integration_hub, "Integration Hub", "Go", "Интеграция с внешними системами")
    Component(event_backbone, "Cloud Event Bus", "Managed Kafka/PubSub", "Событийная шина")
    ComponentDb(oltp_db, "OLTP DB", "Managed PostgreSQL", "Операционные данные")
    ComponentDb(cache, "Hot Cache", "Redis Cluster", "Быстрый доступ к активным данным")
    ComponentDb(data_lake, "Data Lake", "Object Storage", "Сырое видео и события")
    ComponentDb(warehouse, "Warehouse", "Cloud DW", "Аналитические витрины")
}

Rel(operator, api_gateway, "Мониторинг и подтверждение тревог", "HTTPS")
