Rel(frame_preprocessor, video_analytics, "Нормализованные кадры", "gRPC")
Rel(video_analytics, ai_platform, "Загрузка и обновление моделей", "HTTPS")
Rel(video_analytics, behavior_analyzer, "Результаты детекции", "gRPC")
Rel(behavior_analyzer, livestock_counter, "Сигналы об изменении поведения", "gRPC")
Rel(livestock_counter, local_event_store, "Запись состояния поголовья", "SQL")
Rel(video_analytics, local_event_store, "Сохранение результатов анализа", "SQL")
Rel(behavior_analyzer, local_event_store, "Сохранение доменных событий", "SQL")
Rel(feeding_control, plc, "Команды управления", "MQTT/Modbus")
Rel(equipment_monitor, local_event_store, "Запись метрик оборудования", "SQL")
Rel(alert_dispatcher, notification_system, "Отправка тревог", "API")
Rel(sync_agent, local_event_store, "Читает очередь отправки", "SQL")
Rel(sync_agent, core_api, "Синхронизация данных", "gRPC/HTTPS")
Rel(edge_api, alert_dispatcher, "Подтверждение и эскалация тревог", "gRPC")
Rel(edge_api, feeding_control, "Команды для оборудования", "gRPC")
Rel(edge_api, equipment_monitor, "Запросы состояния", "gRPC")
Rel(edge_api, livestock_counter, "Запросы пересчета", "gRPC")

Rel(core_api, access_service, "Аутентификация и авторизация", "OIDC")
Rel(access_service, idp, "Проверка токенов", "OIDC")
Rel(core_api, data_aggregation, "Маршрутизация запросов", "gRPC")
Rel(data_aggregation, event_backbone, "Публикация событий", "Kafka")
Rel(incident_orchestrator, event_backbone, "Чтение инцидентов", "Kafka")
Rel(notification_service, notification_system, "Доставка уведомлений", "API")
Rel(integration_hub, erp_system, "Передача данных о поголовье и кормах", "REST")
Rel(integration_hub, bi_system, "Экспорт метрик и KPI", "REST")
Rel(data_aggregation, operational_db, "Операционные записи", "SQL")
Rel(data_aggregation, analytics_db, "Аналитические данные", "ETL")
Rel(data_aggregation, media_archive, "Ссылки на видеофрагменты", "S3 API")
Rel(incident_orchestrator, notification_service, "Запрос на оповещение", "gRPC")
Rel(incident_orchestrator, data_aggregation, "Запрос контекста событий", "gRPC")
Rel(notification_service, event_backbone, "Публикация статусов доставки", "Kafka")

